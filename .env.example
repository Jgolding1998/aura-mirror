# No key is required for closet, camera, hand tracking or live garment overlays.
HOST=127.0.0.1
PORT=8787

# Optional current weather in the welcome briefing, powered by Open-Meteo.
# AURA_WEATHER_CITY=Your city
# AURA_WEATHER_LAT=
# AURA_WEATHER_LON=
# AURA_WAKE_MUSIC=absolute path to a local audio file

# Free British male voice on your CPU. See docs/SETUP.md to download the model.
# LOCAL_TTS_URL=http://127.0.0.1:8791
# START_LOCAL_VOICE=true
# KOKORO_VOICE=bm_george

# Meta Model API: add the existing key locally. Never use VITE_ for secrets.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3

# Eldrin is a British baritone. Add it to My Voices if required by your account.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=6WwXjDDEMyNmFG95zycZ
ELEVENLABS_MODEL=eleven_flash_v2_5

# Local CPU or remote GPU. See docs/SETUP.md.
TRYON_SERVICE_URL=
TRYON_SERVICE_TOKEN=
# FASHN_DEVICE=cpu
# START_LOCAL_TRYON=true
# FASHN_WEIGHTS_DIR=
# FASHN_CACHE_DIR=
# FASHN_PYTHONPATH=

# Optional whisper.cpp server (with --convert for browser WebM):
WHISPER_URL=

# Optional CORS-enabled MJPEG feed or snapshot stream from a Pi:
CAMERA_STREAM_URL=
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8787,http://127.0.0.1:8787
